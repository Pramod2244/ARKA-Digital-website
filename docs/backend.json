{
  "entities": {
    "ContactSubmission": {
      "title": "Contact Submission",
      "description": "Details from the contact form submission",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "subject", "message", "createdAt"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/contacts/{contactId}": {
      "schema": "ContactSubmission",
      "description": "Inquiries sent via the contact form"
    }
  }
}